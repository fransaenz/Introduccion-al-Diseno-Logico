module MAIN_semaforos_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLKin;
reg M;
reg Q0;
reg Q1;
reg Q2;
reg Q3;
reg RSTn;
// wires                                               
wire P1r;
wire P1v;
wire P3r;
wire P3v;
wire S1a;
wire S1r;
wire S1v;
wire S2a;
wire S2r;
wire S2v;
wire S3a;
wire S3r;
wire S3v;
wire S4a;
wire S4r;
wire S4v;

wire sampler;                             

// assign statements (if any)                          
MAIN_semaforos i1 (
// port map - connection between master ports and signals/registers   
	.CLKin(CLKin),
	.M(M),
	.P1r(P1r),
	.P1v(P1v),
	.P3r(P3r),
	.P3v(P3v),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.Q3(Q3),
	.RSTn(RSTn),
	.S1a(S1a),
	.S1r(S1r),
	.S1v(S1v),
	.S2a(S2a),
	.S2r(S2r),
	.S2v(S2v),
	.S3a(S3a),
	.S3r(S3r),
	.S3v(S3v),
	.S4a(S4a),
	.S4r(S4r),
	.S4v(S4v)
);

// CLKin
initial
begin
	repeat(49)
	begin
		CLKin = 1'b0;
		CLKin = #10000 1'b1;
		# 10000;
	end
	CLKin = 1'b0;
	CLKin = #10000 1'b1;
	CLKin = #9000 1'b0;
end 

// M
initial
begin
	M = 1'b0;
	M = #10000 1'b1;
end 

// Q0
initial
begin
	Q0 = 1'b0;
end 

// Q1
initial
begin
	Q1 = 1'b0;
end 

// Q2
initial
begin
	Q2 = 1'b0;
end 

// Q3
initial
begin
	Q3 = 1'b0;
end 

// RSTn
initial
begin
	RSTn = 1'b0;
end 

MAIN_semaforos_vlg_sample_tst tb_sample (
	.CLKin(CLKin),
	.M(M),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.Q3(Q3),
	.RSTn(RSTn),
	.sampler_tx(sampler)
);

MAIN_semaforos_vlg_check_tst tb_out(
	.P1r(P1r),
	.P1v(P1v),
	.P3r(P3r),
	.P3v(P3v),
	.S1a(S1a),
	.S1r(S1r),
